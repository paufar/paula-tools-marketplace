# `make check` is the single "is the repo consistent?" command used by the
# clock in / clock out steps in AGENTS.md. Replace the commands below with
# your project's own. It must exit non-zero on any failure.

.PHONY: check

check:
	@echo "Replace this target with your lint, type-check, test and build commands"
	@echo "e.g. npm run lint && npm run typecheck && npm test && npm run build"
	@exit 1
